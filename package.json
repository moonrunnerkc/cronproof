{
  "name": "cronproof",
  "version": "0.1.0",
  "description": "Differential prover for cron schedule hazards across timezone offset transitions",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.13.1",
  "bin": {
    "cronproof": "./dist/cli.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "vendor"
  ],
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage --reporter=verbose",
    "crosscheck": "tsx scripts/cross-check.ts",
    "dialect-table": "tsx scripts/dialect-table.ts",
    "hazard-table": "tsx scripts/hazard-table.ts",
    "differential-table": "tsx scripts/differential-table.ts",
    "build": "tsup",
    "evidence": "tsx scripts/evidence.ts",
    "evidence:check": "tsx scripts/evidence.ts --check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
